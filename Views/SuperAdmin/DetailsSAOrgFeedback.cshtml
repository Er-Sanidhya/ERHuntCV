@model ERHuntCV.Models.SAOrgFeedbackM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Feedback Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/SADetailsOrgFeedback.css"
          asp-append-version="true" />

}

<div class="feedback-page">

    <div class="feedback-main-card">

        <!-- =====================================================
             PAGE HEADING
             ===================================================== -->

        <h1 class="feedback-heading">
            Organization Feedback Details
        </h1>


        <!-- =====================================================
             QUESTION 1
             ===================================================== -->

        <div class="feedback-question">

            <div class="question-number">
                QUESTION 1
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que1
                </div>

                <div class="answer-area">

                    <div class="description-answer">

                        @if (Model.Ans1 == "True")
                        {
                            <span class="answer-radio">
                                <input type="radio"
                                       checked
                                       disabled />
                                True
                            </span>

                            <span class="answer-radio">
                                <input type="radio"
                                       disabled />
                                False
                            </span>
                        }
                        else if (Model.Ans1 == "False")
                        {
                            <span class="answer-radio">
                                <input type="radio"
                                       disabled />
                                True
                            </span>

                            <span class="answer-radio">
                                <input type="radio"
                                       checked
                                       disabled />
                                False
                            </span>
                        }
                        else
                        {
                            @Model.Ans1
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUESTION 2
             ===================================================== -->

        <div class="feedback-question">

            <div class="question-number">
                QUESTION 2
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que2
                </div>

                <div class="answer-area">

                    <div class="description-answer">

                        @{
                            int starRating = 0;

                            int.TryParse(Model.Ans2, out starRating);
                        }

                        <div class="detail-stars">

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= starRating)
                                {
                                    <span class="detail-star active">
                                        ★
                                    </span>
                                }
                                else
                                {
                                    <span class="detail-star">
                                        ★
                                    </span>
                                }
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUESTION 3
             ===================================================== -->

        <div class="feedback-question">

            <div class="question-number">
                QUESTION 3
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que3
                </div>

                <div class="answer-area">

                    <div class="description-answer">

                        @if (Model.Ans3 == "Yes")
                        {
                            <span class="answer-radio">
                                <input type="radio"
                                       checked
                                       disabled />
                                Yes
                            </span>

                            <span class="answer-radio">
                                <input type="radio"
                                       disabled />
                                No
                            </span>
                        }
                        else if (Model.Ans3 == "No")
                        {
                            <span class="answer-radio">
                                <input type="radio"
                                       disabled />
                                Yes
                            </span>

                            <span class="answer-radio">
                                <input type="radio"
                                       checked
                                       disabled />
                                No
                            </span>
                        }
                        else
                        {
                            @Model.Ans3
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUESTION 4
             ===================================================== -->

        <div class="feedback-question">

            <div class="question-number">
                QUESTION 4
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que4
                </div>

                <div class="answer-area">

                    <div class="description-answer">

                        @{
                            int emojiRating = 0;

                            int.TryParse(Model.Ans4, out emojiRating);
                        }

                        <div class="detail-emojis">

                            <span class="detail-emoji @(emojiRating == 1 ? "active" : "")">
                                😟
                            </span>

                            <span class="detail-emoji @(emojiRating == 2 ? "active" : "")">
                                😧
                            </span>

                            <span class="detail-emoji @(emojiRating == 3 ? "active" : "")">
                                😃
                            </span>

                            <span class="detail-emoji @(emojiRating == 4 ? "active" : "")">
                                😄
                            </span>

                            <span class="detail-emoji @(emojiRating == 5 ? "active" : "")">
                                😍
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             QUESTION 5
             ===================================================== -->

        <div class="feedback-question">

            <div class="question-number">
                QUESTION 5
            </div>

            <div class="question-content">

                <div class="question-text">
                    @Model.Que5
                </div>

                <div class="answer-area">

                    <div class="description-answer">
                        @Model.Ans5
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             BUTTON AREA
             ===================================================== -->

        <div class="feedback-buttons">

            <a asp-action="Index"
               class="back-btn">
                Back
            </a>

        </div>

    </div>

</div>

